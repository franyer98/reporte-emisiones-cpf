{
  // El sitio son archivos estáticos. Cuando el almacén de datos esté
  // configurado, aquí se añaden "main" y "kv_namespaces" para que el
  // programa de src/index.js guarde y entregue los datos del tablero.
  "name": "reporte-emisiones-cpf",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./",
    // una dirección sin archivo (…/editor/) sirve el index de esa carpeta
    "not_found_handling": "404-page"
  }
}
